# Copy to .env for local use, or set these as environment variables on your host.

# Neon PostgreSQL connection string (from neon.tech dashboard)
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# Required in production. Signs the login cookie — a random value, kept secret.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Cloudinary credentials (from cloudinary.com dashboard)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Port the site listens on. Most hosts set this for you.
PORT=3000

# Set to "production" when the site is live. Enables secure cookies.
NODE_ENV=development

# Largest single image upload, in megabytes.
MAX_UPLOAD_MB=15
