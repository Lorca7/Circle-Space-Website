<%- include('../partials/head') %>

<div class="page page--standard">
  <div class="blocks">
    <% if (settings.home_image) { %>
      <section class="block">
        <div class="container">
          <figure class="single-image single-image--full">
            <button type="button" class="single-image__trigger"
                    aria-label="Enlarge: <%= settings.home_image_alt || 'Home image' %>"
                    data-lightbox-src="/uploads/<%= settings.home_image %>"
                    data-lightbox-alt="<%= settings.home_image_alt || '' %>">
              <img src="/uploads/<%= settings.home_image %>"
                   alt="<%= settings.home_image_alt %>" loading="eager">
            </button>
            <% if (settings.home_caption) { %>
              <figcaption><%= settings.home_caption %></figcaption>
            <% } %>
          </figure>
        </div>
      </section>
    <% } else { %>
      <section class="block">
        <div class="container">
          <div class="empty-state">
            <p class="empty-state__title">No home page image yet</p>
            <p class="empty-state__body">Choose the piece that opens the site under <strong>Site text</strong> in the admin panel.</p>
            <p class="empty-state__action"><a class="button" href="/admin">Open the admin panel</a></p>
          </div>
        </div>
      </section>
    <% } %>
  </div>
</div>

<%- include('../partials/foot') %>
