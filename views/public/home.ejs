<%- include('../partials/head') %>

<% if (settings.home_image) { %>
  <figure class="home-figure">
    <img src="/uploads/<%= settings.home_image %>"
         alt="<%= settings.home_image_alt %>" fetchpriority="high">
    <% if (settings.home_caption) { %>
      <figcaption class="home-caption"><%= settings.home_caption %></figcaption>
    <% } %>
  </figure>
<% } else { %>
  <div class="empty-state">
    <p class="empty-title">No home page image yet</p>
    <p class="empty-body">
      Choose the piece that opens the site under <strong>Site text</strong> in the admin panel.
    </p>
    <p class="empty-action"><a class="button" href="/admin">Open the admin panel</a></p>
  </div>
<% } %>

<%- include('../partials/foot') %>
