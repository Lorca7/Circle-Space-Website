<%- include('../partials/head') %>
<header class="collection-header">
  <h1 class="collection-title"><%= settings.about_heading || 'About' %></h1>
</header>
<% if (settings.about_body) { %>
  <div class="prose prose-centred"><%- include('../partials/prose', { text: settings.about_body }) %></div>
<% } else { %>
  <div class="empty-state">
    <p class="empty-title">Nothing here yet</p>
    <p class="empty-body">Write your about text in the admin panel under Site text.</p>
  </div>
<% } %>
<%- include('../partials/foot') %>
