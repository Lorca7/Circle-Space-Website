<%- include('../partials/head') %>

<div class="page page--text">
  <div class="blocks">
    <% if (settings.about_body) { %>
      <section class="block">
        <div class="container container--align-left">
          <div class="richtext richtext--normal richtext--align-left prose">
            <%- include('../partials/prose', { text: settings.about_body }) %>
          </div>
        </div>
      </section>
    <% } else { %>
      <section class="block">
        <div class="container">
          <div class="empty-state">
            <p class="empty-state__title">Nothing here yet</p>
            <p class="empty-state__body">Write your about text in the admin panel under Site text.</p>
          </div>
        </div>
      </section>
    <% } %>
  </div>
</div>

<%- include('../partials/foot') %>
