<%- include('../partials/head') %>
<h1 class="page-heading">Videos</h1>
<% if (videos.length) { %>
  <ul class="video-list">
    <% videos.forEach(function (video) { %>
      <li class="video-item"><%- include('../partials/video', { video: video }) %></li>
    <% }); %>
  </ul>
<% } else { %>
  <%- include('../partials/empty', {
    title: 'No videos yet',
    body: 'Add YouTube or Vimeo links in the admin panel and they will play here.'
  }) %>
<% } %>
<%- include('../partials/foot') %>
