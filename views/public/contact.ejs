<%- include('../partials/head') %>

<div class="page page--standard">
  <div class="blocks">

    <section class="block">
      <div class="container">
        <h2 class="section-heading"><%= settings.contact_heading || 'Get in touch' %></h2>

        <% if (settings.contact_intro) { %>
          <p class="muted"><%= settings.contact_intro %></p>
        <% } %>

        <% if (sent) { %>
          <p class="form__status form__status--success" role="status">Thank you &mdash; your message has been sent.</p>
        <% } %>
        <% if (formError) { %>
          <p class="form__status form__status--error" role="alert"><%= formError %></p>
        <% } %>

        <form method="post" action="/contact" class="form">
          <div class="form__field">
            <label for="cf-name">Name</label>
            <input type="text" id="cf-name" name="name" class="form__input"
                   value="<%= form.name || '' %>" maxlength="200" required>
          </div>
          <div class="form__field">
            <label for="cf-email">Email</label>
            <input type="email" id="cf-email" name="email" class="form__input"
                   value="<%= form.email || '' %>" maxlength="200" required>
          </div>
          <div class="form__field">
            <label for="cf-subject">Subject</label>
            <input type="text" id="cf-subject" name="subject" class="form__input"
                   value="<%= form.subject || '' %>" maxlength="300">
          </div>
          <div class="form__field">
            <label for="cf-message">Message</label>
            <textarea id="cf-message" name="message" class="form__textarea"
                      rows="7" maxlength="5000" required><%= form.body || '' %></textarea>
          </div>
          <div class="form__honeypot" aria-hidden="true">
            <label>Company <input type="text" name="website" tabindex="-1" autocomplete="off"></label>
          </div>
          <button type="submit" class="button">Send message</button>
        </form>
      </div>
    </section>

    <section class="block">
      <div class="container">
        <h2 class="section-heading"><%= settings.newsletter_heading || 'Studio updates' %></h2>

        <% if (settings.newsletter_intro) { %>
          <p class="muted"><%= settings.newsletter_intro %></p>
        <% } %>

        <% if (subscribed) { %>
          <p class="form__status form__status--success" role="status">Thank you &mdash; you are on the list.</p>
        <% } %>
        <% if (signupError) { %>
          <p class="form__status form__status--error" role="alert"><%= signupError %></p>
        <% } %>

        <form method="post" action="/subscribe">
          <div class="newsletter-form">
            <label class="sr-only" for="signup-email">Email address</label>
            <input id="signup-email" type="email" name="email" class="form__input"
                   placeholder="your@email.com" aria-label="Email address" maxlength="200" required>
            <div class="form__honeypot" aria-hidden="true">
              <label>Company <input type="text" name="website" tabindex="-1" autocomplete="off"></label>
            </div>
            <button type="submit" class="button">Subscribe</button>
          </div>
        </form>
      </div>
    </section>

  </div>
</div>

<%- include('../partials/foot') %>
