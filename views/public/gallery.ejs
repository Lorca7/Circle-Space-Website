<%- include('../partials/head') %>
<h1 class="page-heading">Gallery</h1>
<% if (photos.length) { %>
  <ul class="photo-grid">
    <% photos.forEach(function (photo) { %>
      <li class="photo-item">
        <a href="/uploads/<%= photo.filename %>" target="_blank" rel="noopener noreferrer">
          <img src="/uploads/<%= photo.filename %>" alt="<%= photo.alt_text || photo.caption %>" loading="lazy">
        </a>
        <% if (photo.caption) { %><p class="photo-caption"><%= photo.caption %></p><% } %>
      </li>
    <% }); %>
  </ul>
<% } else { %>
  <%- include('../partials/empty', {
    title: 'No photos yet',
    body: 'Upload images in the admin panel and they will show up on this page.'
  }) %>
<% } %>
<%- include('../partials/foot') %>
