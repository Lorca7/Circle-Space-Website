<%- include('../partials/admin-head') %>
<p class="lead">
  <a href="/admin/pages">&larr; All pages</a>
  <% if (page.published) { %>
    · <a href="/p/<%= page.slug %>" target="_blank" rel="noopener">View on the site &nearr;</a>
  <% } %>
</p>
<form method="post" action="/admin/pages/<%= page.id %>" class="stack form-wide">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <label>Title
    <input type="text" name="title" value="<%= page.title %>" maxlength="200" required>
  </label>
  <label>Web address
    <span class="slug-row">
      <span class="slug-prefix">/p/</span>
      <input type="text" name="slug" value="<%= page.slug %>" maxlength="80">
    </span>
    <span class="hint">Tidied automatically. If it is already taken, a number is added.</span>
  </label>
  <label>Text
    <textarea name="body" rows="18"><%= page.body %></textarea>
    <span class="hint">Leave a blank line between paragraphs.</span>
  </label>
  <label class="checkbox">
    <input type="checkbox" name="published" <%= page.published ? 'checked' : '' %>>
    Published — show this page in the site menu
  </label>
  <button type="submit" class="button">Save page</button>
</form>
<%- include('../partials/admin-foot') %>
