<%- include('../partials/admin-head') %>

<form method="post" action="/admin/pages" class="stack panel">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <label>New page title
    <input type="text" name="title" maxlength="200" required>
    <span class="hint">You can write the text on the next screen.</span>
  </label>
  <button type="submit" class="button">Create page</button>
</form>

<% if (!pages.length) { %>
  <p class="empty-row">No extra pages yet.</p>
<% } else { %>
  <ul class="admin-list">
    <% pages.forEach(function (page, i) { %>
      <li class="admin-row admin-row-compact">
        <div class="row-main">
          <a class="row-title" href="/admin/pages/<%= page.id %>"><%= page.title %></a>
          <p class="row-meta">
            /p/<%= page.slug %> ·
            <span class="<%= page.published ? 'badge-live' : 'badge-draft' %>">
              <%= page.published ? 'Published' : 'Draft' %>
            </span>
          </p>
        </div>
        <div class="row-actions">
          <form method="post" action="/admin/pages/<%= page.id %>/move" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="direction" value="up">
            <button type="submit" class="icon-button" title="Move up" <%= i === 0 ? 'disabled' : '' %>>&uarr;</button>
          </form>
          <form method="post" action="/admin/pages/<%= page.id %>/move" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="direction" value="down">
            <button type="submit" class="icon-button" title="Move down" <%= i === pages.length - 1 ? 'disabled' : '' %>>&darr;</button>
          </form>
          <form method="post" action="/admin/pages/<%= page.id %>/delete" class="inline-form"
                onsubmit="return confirm('Delete this page? This cannot be undone.');">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="icon-button danger" title="Delete">Delete</button>
          </form>
        </div>
      </li>
    <% }); %>
  </ul>
<% } %>
<%- include('../partials/admin-foot') %>
