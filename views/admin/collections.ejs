<%- include('../partials/admin-head') %>
<p class="lead">
  Each collection becomes its own page, listed in the site menu once published.
</p>

<form method="post" action="/admin/collections" class="stack panel">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <label>New collection title
    <input type="text" name="title" maxlength="200" required>
  </label>
  <label>What goes in it
    <select name="kind">
      <option value="images">Images — uploaded artwork or photographs</option>
      <option value="videos">Videos — YouTube or Vimeo links</option>
    </select>
    <span class="hint">You can change this later.</span>
  </label>
  <button type="submit" class="button">Create collection</button>
</form>

<% if (!collections.length) { %>
  <p class="empty-row">No collections yet. Create your first one above.</p>
<% } else { %>
  <ul class="admin-list">
    <% collections.forEach(function (c, i) { %>
      <li class="admin-row admin-row-compact">
        <div class="row-main">
          <a class="row-title" href="/admin/collections/<%= c.id %>"><%= c.title %></a>
          <p class="row-meta">
            /c/<%= c.slug %> ·
            <%= c.kind === 'videos' ? 'Videos' : 'Images' %> ·
            <%= c.workCount %> <%= c.workCount === 1 ? 'work' : 'works' %> ·
            <span class="<%= c.published ? 'badge-live' : 'badge-draft' %>">
              <%= c.published ? 'Published' : 'Draft' %>
            </span>
          </p>
        </div>
        <div class="row-actions">
          <form method="post" action="/admin/collections/<%= c.id %>/move" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="direction" value="up">
            <button type="submit" class="icon-button" title="Move up" <%= i === 0 ? 'disabled' : '' %>>&uarr;</button>
          </form>
          <form method="post" action="/admin/collections/<%= c.id %>/move" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="direction" value="down">
            <button type="submit" class="icon-button" title="Move down" <%= i === collections.length - 1 ? 'disabled' : '' %>>&darr;</button>
          </form>
          <form method="post" action="/admin/collections/<%= c.id %>/delete" class="inline-form"
                onsubmit="return confirm('Delete this collection and everything in it? This cannot be undone.');">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="icon-button danger" title="Delete">Delete</button>
          </form>
        </div>
      </li>
    <% }); %>
  </ul>
<% } %>
<%- include('../partials/admin-foot') %>
