<%- include('../partials/admin-head') %>
<p class="lead">
  People who signed up through the contact page.
  <% if (subscribers.length) { %>
    <a href="/admin/subscribers.csv">Download as a spreadsheet</a> to use with any mailing service.
  <% } %>
</p>

<% if (!subscribers.length) { %>
  <p class="empty-row">Nobody has signed up yet.</p>
<% } else { %>
  <ul class="admin-list">
    <% subscribers.forEach(function (s) { %>
      <li class="admin-row admin-row-compact">
        <div class="row-main">
          <span class="row-title"><%= s.email %></span>
          <p class="row-meta"><%= s.created_at %> UTC</p>
        </div>
        <div class="row-actions">
          <form method="post" action="/admin/subscribers/<%= s.id %>/delete" class="inline-form"
                onsubmit="return confirm('Remove this subscriber?');">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="icon-button danger">Remove</button>
          </form>
        </div>
      </li>
    <% }); %>
  </ul>
<% } %>
<%- include('../partials/admin-foot') %>
