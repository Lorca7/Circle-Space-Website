<%- include('../partials/admin-head') %>

<p class="lead">
  Everything on the public site is managed from here. Nothing is filled in yet —
  work through the sections below in any order.
</p>

<ul class="tiles">
  <li class="tile">
    <h2><a href="/admin/settings">Site text</a></h2>
    <p>Your site name, tagline, home page headline, about text and contact details.</p>
    <p class="tile-state <%= settings.site_title ? 'done' : '' %>">
      <%= settings.site_title ? 'Site name set' : 'No site name yet' %>
    </p>
  </li>
  <li class="tile">
    <h2><a href="/admin/photos">Photos</a></h2>
    <p>Upload images for the gallery, add captions, and set the order they appear in.</p>
    <p class="tile-state <%= counts.photos ? 'done' : '' %>">
      <%= counts.photos ? counts.photos + ' uploaded' : 'No photos yet' %>
    </p>
  </li>
  <li class="tile">
    <h2><a href="/admin/videos">Video links</a></h2>
    <p>Paste YouTube or Vimeo links; they are embedded on the site automatically.</p>
    <p class="tile-state <%= counts.videos ? 'done' : '' %>">
      <%= counts.videos ? counts.videos + ' added' : 'No videos yet' %>
    </p>
  </li>
  <li class="tile">
    <h2><a href="/admin/pages">Pages</a></h2>
    <p>Create extra pages of your own. They join the menu once published.</p>
    <p class="tile-state <%= counts.pages ? 'done' : '' %>">
      <%= counts.pages ? counts.pages + ' created' : 'No extra pages yet' %>
    </p>
  </li>
  <li class="tile">
    <h2><a href="/admin/links">Links</a></h2>
    <p>Outbound links shown in the footer and on the contact page.</p>
    <p class="tile-state <%= counts.links ? 'done' : '' %>">
      <%= counts.links ? counts.links + ' added' : 'No links yet' %>
    </p>
  </li>
  <li class="tile">
    <h2><a href="/admin/account">Your account</a></h2>
    <p>Signed in as <%= currentUser.email %>. Change your password here.</p>
  </li>
</ul>

<%- include('../partials/admin-foot') %>
