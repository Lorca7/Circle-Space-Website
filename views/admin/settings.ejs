<%- include('../partials/admin-head') %>
<p class="lead">All of this starts blank. Anything you leave empty is simply hidden on the site.</p>
<form method="post" action="/admin/settings" class="stack form-wide">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <fieldset>
    <legend>Site identity</legend>
    <label>Site name
      <input type="text" name="site_title" value="<%= settings.site_title %>" maxlength="120">
      <span class="hint">Shown in the header and the browser tab.</span>
    </label>
    <label>Tagline
      <input type="text" name="tagline" value="<%= settings.tagline %>" maxlength="200">
    </label>
  </fieldset>

  <fieldset>
    <legend>Home page</legend>
    <label>Headline
      <input type="text" name="hero_heading" value="<%= settings.hero_heading %>" maxlength="200">
      <span class="hint">Falls back to your site name if left empty.</span>
    </label>
    <label>Sub-heading
      <textarea name="hero_subheading" rows="2" maxlength="500"><%= settings.hero_subheading %></textarea>
    </label>
  </fieldset>

  <fieldset>
    <legend>About page</legend>
    <label>Heading
      <input type="text" name="about_heading" value="<%= settings.about_heading %>" maxlength="200">
    </label>
    <label>Text
      <textarea name="about_body" rows="10"><%= settings.about_body %></textarea>
      <span class="hint">Leave a blank line between paragraphs.</span>
    </label>
  </fieldset>

  <fieldset>
    <legend>Contact page</legend>
    <label>Heading
      <input type="text" name="contact_heading" value="<%= settings.contact_heading %>" maxlength="200">
    </label>
    <label>Text
      <textarea name="contact_body" rows="5"><%= settings.contact_body %></textarea>
    </label>
    <label>Email address
      <input type="email" name="contact_email" value="<%= settings.contact_email %>" maxlength="200">
    </label>
  </fieldset>

  <fieldset>
    <legend>Footer</legend>
    <label>Footer text
      <input type="text" name="footer_text" value="<%= settings.footer_text %>" maxlength="200">
      <span class="hint">Falls back to a copyright line with your site name.</span>
    </label>
  </fieldset>

  <button type="submit" class="button">Save site text</button>
</form>
<%- include('../partials/admin-foot') %>
