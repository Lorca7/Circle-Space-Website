<%- include('../partials/admin-head') %>
<p class="lead">All of this starts blank. Anything you leave empty is simply hidden on the site.</p>

<section class="panel">
  <h2 class="panel-title">Home page image</h2>
  <p class="hint">The single piece that opens the site. Nothing else appears on the home page.</p>

  <% if (settings.home_image) { %>
    <img class="preview" src="/uploads/<%= settings.home_image %>" alt="">
    <form method="post" action="/admin/settings/home-image/delete" class="inline-form"
          onsubmit="return confirm('Remove the home page image?');">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="icon-button danger">Remove image</button>
    </form>
  <% } else { %>
    <p class="empty-row">No home page image yet.</p>
  <% } %>

  <form method="post" action="/admin/settings/home-image" enctype="multipart/form-data" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label><%= settings.home_image ? 'Replace it' : 'Choose an image' %>
      <input type="file" name="home_image" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" required>
    </label>
    <button type="submit" class="button">Upload</button>
  </form>
</section>

<form method="post" action="/admin/settings" class="stack form-wide">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <fieldset>
    <legend>Site identity</legend>
    <label>Site name
      <input type="text" name="site_title" value="<%= settings.site_title %>" maxlength="120">
      <span class="hint">Shown at the top of the sidebar on every page.</span>
    </label>
  </fieldset>

  <fieldset>
    <legend>Home page</legend>
    <label>Image description
      <input type="text" name="home_image_alt" value="<%= settings.home_image_alt %>" maxlength="300">
      <span class="hint">Describes the image for screen readers. Not shown on the page.</span>
    </label>
    <label>Caption
      <input type="text" name="home_caption" value="<%= settings.home_caption %>" maxlength="300">
      <span class="hint">Optional line under the image. Also used as the site description for search engines.</span>
    </label>
  </fieldset>

  <fieldset>
    <legend>About page</legend>
    <label>Heading
      <input type="text" name="about_heading" value="<%= settings.about_heading %>" maxlength="200">
      <span class="hint">Falls back to &ldquo;About&rdquo;.</span>
    </label>
    <label>Text
      <textarea name="about_body" rows="10"><%= settings.about_body %></textarea>
      <span class="hint">Leave a blank line between paragraphs.</span>
    </label>
  </fieldset>

  <fieldset>
    <legend>Contact page</legend>
    <label>Heading
      <input type="text" name="contact_heading" value="<%= settings.contact_heading %>" maxlength="200">
      <span class="hint">Falls back to &ldquo;Get in touch&rdquo;.</span>
    </label>
    <label>Text above the form
      <textarea name="contact_intro" rows="3"><%= settings.contact_intro %></textarea>
    </label>
    <label>Your email address
      <input type="email" name="contact_email" value="<%= settings.contact_email %>" maxlength="200">
      <span class="hint">For your own reference. Messages are kept in the admin panel, not emailed.</span>
    </label>
  </fieldset>

  <fieldset>
    <legend>Studio updates</legend>
    <label>Heading
      <input type="text" name="newsletter_heading" value="<%= settings.newsletter_heading %>" maxlength="200">
      <span class="hint">Falls back to &ldquo;Studio updates&rdquo;.</span>
    </label>
    <label>Text above the sign-up box
      <textarea name="newsletter_intro" rows="3"><%= settings.newsletter_intro %></textarea>
    </label>
  </fieldset>

  <fieldset>
    <legend>Footer</legend>
    <label>Footer text
      <input type="text" name="footer_text" value="<%= settings.footer_text %>" maxlength="200">
      <span class="hint">Left empty, no footer is shown at all.</span>
    </label>
  </fieldset>

  <button type="submit" class="button">Save site text</button>
</form>
<%- include('../partials/admin-foot') %>
