<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> · Admin</title>
<meta name="robots" content="noindex, nofollow">
<link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin">
<header class="admin-header">
  <div class="admin-wrap admin-header-inner">
    <span class="admin-brand">Admin<% if (!siteTitleIsPlaceholder) { %> · <%= siteTitle %><% } %></span>
    <div class="admin-header-right">
      <a href="/" target="_blank" rel="noopener">View site &nearr;</a>
      <form method="post" action="/admin/logout" class="inline-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="link-button">Sign out</button>
      </form>
    </div>
  </div>
</header>
<div class="admin-wrap admin-body">
  <nav class="admin-nav" aria-label="Admin sections">
    <a href="/admin" class="<%= active === 'dashboard' ? 'current' : '' %>">Dashboard</a>
    <a href="/admin/settings" class="<%= active === 'settings' ? 'current' : '' %>">Site text</a>
    <a href="/admin/collections" class="<%= active === 'collections' ? 'current' : '' %>">Collections <span class="count"><%= counts.collections %></span></a>
    <a href="/admin/messages" class="<%= active === 'messages' ? 'current' : '' %>">Messages <span class="count <%= counts.unread ? 'count-alert' : '' %>"><%= counts.unread ? counts.unread + ' new' : counts.messages %></span></a>
    <a href="/admin/subscribers" class="<%= active === 'subscribers' ? 'current' : '' %>">Studio updates <span class="count"><%= counts.subscribers %></span></a>
    <a href="/admin/account" class="<%= active === 'account' ? 'current' : '' %>">Your account</a>
  </nav>
  <section class="admin-main">
    <h1 class="admin-title"><%= title %></h1>
    <% if (notice) { %><p class="flash flash-ok" role="status"><%= notice %></p><% } %>
    <% if (errorMessage) { %><p class="flash flash-error" role="alert"><%= errorMessage %></p><% } %>
