<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> · Admin</title>
<meta name="robots" content="noindex, nofollow">
<link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin">
<header class="admin-header">
  <div class="admin-wrap admin-header-inner">
    <span class="admin-brand">Admin<% if (!siteTitleIsPlaceholder) { %> · <%= siteTitle %><% } %></span>
    <div class="admin-header-right">
      <a href="/" target="_blank" rel="noopener">View site &nearr;</a>
      <form method="post" action="/admin/logout" class="inline-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="link-button">Sign out</button>
      </form>
    </div>
  </div>
</header>
<div class="admin-wrap admin-body">
  <nav class="admin-nav" aria-label="Admin sections">
    <a href="/admin" <%= active === 'dashboard' ? 'class="current"' : '' %>>Dashboard</a>
    <a href="/admin/settings" <%= active === 'settings' ? 'class="current"' : '' %>>Site text</a>
    <a href="/admin/photos" <%= active === 'photos' ? 'class="current"' : '' %>>Photos <span class="count"><%= counts.photos %></span></a>
    <a href="/admin/videos" <%= active === 'videos' ? 'class="current"' : '' %>>Video links <span class="count"><%= counts.videos %></span></a>
    <a href="/admin/pages" <%= active === 'pages' ? 'class="current"' : '' %>>Pages <span class="count"><%= counts.pages %></span></a>
    <a href="/admin/links" <%= active === 'links' ? 'class="current"' : '' %>>Links <span class="count"><%= counts.links %></span></a>
    <a href="/admin/account" <%= active === 'account' ? 'class="current"' : '' %>>Your account</a>
  </nav>
  <section class="admin-main">
    <h1 class="admin-title"><%= title %></h1>
    <% if (notice) { %><p class="flash flash-ok" role="status"><%= notice %></p><% } %>
    <% if (errorMessage) { %><p class="flash flash-error" role="alert"><%= errorMessage %></p><% } %>
